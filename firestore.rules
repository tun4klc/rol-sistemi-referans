rules_version = '2';

// Rol tabanlı + çoklu şirket Firestore kuralları (şablon).
// Roller: "teknisyen" | "mudur" | "admin"   —   Koleksiyonlar: users, services, notifications
// Kendi projene uyarlarken koleksiyon/alan isimlerini değiştir.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Yardımcı fonksiyonlar ----------
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return me().get('role', 'teknisyen');
    }

    function myCompany() {
      return me().get('companyId', null);
    }

    function isManager() {
      return myRole() in ['mudur', 'admin'];
    }

    function isAdmin() {
      return myRole() == 'admin';
    }

    function sameCompany(companyId) {
      return myCompany() != null && companyId == myCompany();
    }

    // ---------- Kullanıcılar ----------
    match /users/{userId} {
      function targetCompany() {
        return resource.data.get('companyId', null);
      }

      allow read: if signedIn() && (
        request.auth.uid == userId
        || sameCompany(targetCompany())
        || (isAdmin() && targetCompany() == null)          // onay bekleyenleri görebilsin
      );

      // Kayıt: sadece kendi belgesi, en düşük rol, şirketsiz.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'teknisyen'
        && request.resource.data.get('companyId', null) == null;

      allow update: if signedIn() && (
        // Kendisi: rol ve şirket hariç her şeyi
        (request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyId']))
        // Admin: kendi şirketindeki veya şirketsiz kullanıcıyı kendi şirketine alır / rol atar
        || (isAdmin()
          && (sameCompany(targetCompany()) || targetCompany() == null)
          && request.resource.data.get('companyId', null) == myCompany()
          && request.resource.data.role in ['teknisyen', 'mudur', 'admin'])
      );

      allow delete: if signedIn()
        && isAdmin()
        && sameCompany(targetCompany())
        && request.auth.uid != userId;
    }

    // ---------- Servisler ----------
    match /services/{serviceId} {
      function isMine() {
        return resource.data.get('technicianId', null) == request.auth.uid;
      }

      allow read: if signedIn()
        && sameCompany(resource.data.companyId)
        && (isManager() || isMine());

      allow create: if signedIn()
        && sameCompany(request.resource.data.companyId)
        && (isManager() || request.resource.data.get('technicianId', null) == request.auth.uid);

      allow update: if signedIn()
        && sameCompany(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && (isManager()
          || (isMine() && request.resource.data.get('technicianId', null) == request.auth.uid));

      allow delete: if signedIn()
        && sameCompany(resource.data.companyId)
        && isManager();
    }

    // ---------- Bildirimler ----------
    // recipientId: kullanıcı uid'si veya herkese gidenler için "all"
    match /notifications/{notificationId} {
      function isForMe() {
        return resource.data.get('recipientId', 'all') in [request.auth.uid, 'all'];
      }

      allow read: if signedIn()
        && sameCompany(resource.data.companyId)
        && (isManager() || isForMe());

      allow create: if signedIn()
        && sameCompany(request.resource.data.companyId);

      allow update: if signedIn()
        && sameCompany(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && (isManager() || isForMe());

      allow delete: if signedIn()
        && sameCompany(resource.data.companyId)
        && isManager();
    }
  }
}
